# Copy this file to .env locally. Never commit .env or real API keys.

# Provider used to summarize passages retrieved from the local legal dataset.
# Configure this only for a provider you actually have access to.
LEGAL_SUMMARY_PROVIDER=gemini
LEGAL_SUMMARY_API_KEY=
LEGAL_SUMMARY_BASE_URL=
LEGAL_SUMMARY_MODEL=

# Google Gemini fallback for queries with no sufficiently relevant dataset match.
GEMINI_API_KEY=
GEMINI_MODEL=

# Local dataset and index paths
CYBERSAATHI_DATA_DIR=./data/raw/kanoongpt_indian_legal_documents
CYBERSAATHI_INDEX_PATH=./data/index/legal_documents.sqlite

# Retrieval tuning; implementation should validate and document these values.
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=

# Server configuration
HOST=127.0.0.1
PORT=8000
